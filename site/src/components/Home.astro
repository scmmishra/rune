---
import Keycap from "./Keycap.astro";
import { latest } from "../lib/releases";
import { DOWNLOAD, REQUIREMENTS } from "../lib/site";
import { headline, lede, more, shortcuts, traits } from "../lib/home";

// The name as four keys, set a little loose, like stones laid by hand.
// The two nouns the headline is about get their own cut.
const words = headline.split(" ").map((word, index, all) => ({ word, accent: word === "repo" || word === "agents.", last: index === all.length - 1 }));

const letters = [
  { letter: "R", tilt: -4, lift: 3 },
  { letter: "U", tilt: 2, lift: -2 },
  { letter: "N", tilt: -1.5, lift: 2 },
  { letter: "E", tilt: 5, lift: -3 },
];
---
  <section class="wrap hero">
    <div class="word" aria-hidden="true" title="Type the letters">
      {letters.map(item => (
        <span class="rune" data-key={item.letter.toLowerCase()} data-meta="false" style={`--tilt: ${item.tilt}deg; --lift: ${item.lift}px`}>
          {item.letter}
        </span>
      ))}
    </div>
    <h1>
      {words.map(item => (
        <>
          {item.accent ? <em>{item.word}</em> : item.word}{item.last ? "" : " "}
        </>
      ))}
    </h1>
    <p class="lede">{lede}</p>
    <div class="download">
      <a class="button" href={DOWNLOAD}>Download for Mac</a>
      <p class="meta">
        <a href="/changelog">{latest?.version ?? "Latest"}</a>
        <span aria-hidden="true">·</span>
        {REQUIREMENTS}
      </p>
    </div>
  </section>

  <section class="wrap intro">
    <p>
      Rune runs its terminals on Ghostty's terminal engine. Around them, it shows what a plain terminal can't: which agent runs in
      which tab, what changed in the repo, and the file you are talking about.
    </p>
    <p>Rune adds no AI of its own. It works with the agents you already use, and updates itself after you install it.</p>
  </section>

  <section class="wrap traits" aria-labelledby="traits-heading">
    <h2 id="traits-heading">What sets it apart</h2>
    <dl>
      {traits.map(trait => (
        <div class="trait">
          <dt>{trait.name}</dt>
          <dd>{trait.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap keys" aria-labelledby="keys-heading">
    <h2 id="keys-heading">Keys you already know</h2>
    <p class="note">Panes use Ghostty's shortcuts. Press one here and its key lights up.</p>
    <ul class="stones">
      {shortcuts.map(shortcut => (
        <li data-key={shortcut.key} data-shift={String(shortcut.shift)}>
          <span class="caps">
            {shortcut.keys.map(key => <Keycap symbol={key} />)}
          </span>
          <span class="label">{shortcut.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap more" aria-labelledby="more-heading">
    <h2 id="more-heading">Also in Rune</h2>
    <dl>
      {more.map(item => (
        <div>
          <dt>{item.href ? <a href={item.href}>{item.name}</a> : item.name}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>

<script>
  import { lightKeys } from "../lib/keys";
  lightKeys();
</script>

<style>
  h2 {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0 0 1.5rem;
  }

  .hero {
    padding-top: clamp(3rem, 10vw, 7rem);
  }

  .word {
    display: flex;
    gap: 0.45rem;
    margin-bottom: 2.25rem;
  }

  .rune {
    display: grid;
    place-items: center;
    width: 3rem;
    aspect-ratio: 1;
    font: 600 1.5rem / 1 var(--display);
    color: var(--ink);
    background: radial-gradient(120% 90% at 30% 15%, color-mix(in srgb, var(--surface) 85%, white), var(--stone) 70%);
    border: 1px solid var(--line);
    border-radius: 22%;
    box-shadow:
      0 3px 0 var(--stone-edge),
      0 8px 14px -8px rgb(0 0 0 / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.5);
    transform: translateY(var(--lift)) rotate(var(--tilt));
    user-select: none;
  }

  .rune.pressed {
    animation: sink 0.5s ease;
  }

  @keyframes sink {
    0%,
    30% {
      transform: translateY(calc(var(--lift) + 3px)) rotate(var(--tilt));
      box-shadow: 0 0 0 var(--stone-edge), inset 0 1px 0 rgb(255 255 255 / 0.5);
      background: var(--accent);
      color: var(--accent-ink);
    }
  }

  /* Grotesk Black, packed tight, from the variable cut. */
  h1 {
    font-family: "Timeless Variable", var(--display);
    font-size: clamp(2.5rem, 7.5vw, 4.5rem);
    font-variation-settings: "wght" 800, "ital" 0, "STYL" 0;
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0;
    text-wrap: balance;
  }

  /* The nouns keep the headline's cut and take the accent color. */
  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .lede {
    font-size: 1.1875rem;
    color: var(--muted);
    margin: 1.5rem 0 0;
    max-width: 36rem;
  }

  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-block;
    background: var(--ink);
    color: var(--ground);
    text-decoration: none;
    font-weight: 600;
    padding: 0.7rem 1.2rem;
    border-radius: 10px;
    transition: transform 0.12s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button:active {
    transform: translateY(1px);
  }

  .meta {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .meta span {
    margin: 0 0.35rem;
  }

  .intro {
    margin-top: 4.5rem;
  }

  .intro p {
    margin: 0 0 1rem;
  }

  .traits,
  .keys,
  .more {
    margin-top: 5rem;
  }

  .traits dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .trait {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .trait dt {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .trait dd {
    margin: 0;
  }

  .note {
    color: var(--muted);
    margin: -0.75rem 0 1.5rem;
  }

  .stones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 1.5rem 1rem;
  }

  .stones li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .caps {
    display: flex;
    gap: 0.3rem;
  }

  .stones :global(kbd) {
    display: grid;
    place-items: center;
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    background: linear-gradient(to bottom, color-mix(in srgb, var(--surface) 70%, var(--stone)), var(--stone));
    border: 1px solid var(--line);
    border-radius: 9px;
    box-shadow:
      0 2px 0 var(--stone-edge),
      inset 0 1px 0 color-mix(in srgb, white 45%, transparent);
    transition: background 0.2s ease;
  }

  .stones .label {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .stones li.pressed :global(kbd) {
    animation: press 0.6s ease;
  }

  @keyframes press {
    0% {
      transform: translateY(2px);
      box-shadow: 0 0 0 var(--stone-edge);
      background: var(--accent);
      color: var(--accent-ink);
    }
    35% {
      transform: translateY(2px);
      box-shadow: 0 0 0 var(--stone-edge);
      background: var(--accent);
      color: var(--accent-ink);
    }
    100% {
      transform: translateY(0);
    }
  }

  .more dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.75rem 2rem;
  }

  .more dt {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .more dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 560px) {
    .trait {
      grid-template-columns: 1fr;
    }
  }
</style>
