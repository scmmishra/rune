---
import { latest } from "../lib/releases";
import { DOWNLOAD } from "../lib/site";
---

<a class="float" href={DOWNLOAD}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /></svg>
  Download for Mac
  <span>{latest?.version}</span>
</a>

<script>
  // Shown on every page. A page with its own download button, such as the home page,
  // hides it while that button is on screen, so the same link never shows twice.
  const float = document.querySelector<HTMLElement>(".float");
  const own = document.querySelector(".download");
  if (float && own) {
    new IntersectionObserver(([entry]) => {
      float.classList.toggle("shown", !entry.isIntersecting);
    }).observe(own);
  } else {
    float?.classList.add("shown");
  }
</script>

<style>
  .float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem 0.65rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ground);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.15),
      0 12px 28px -10px rgb(0 0 0 / 0.45);
    opacity: 0;
    transform: translateY(1.5rem);
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.3, 1),
      visibility 0s 0.3s;
  }

  /* Hidden also takes it out of the tab order. Visibility flips at once when shown, and after the slide when hidden. */
  .float.shown {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }

  .float.shown:hover {
    transform: translateY(-1px);
  }

  .float svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .float span {
    font: 400 0.75rem/1 var(--mono);
    opacity: 0.6;
  }</style>
