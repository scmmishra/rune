---
import "../styles/fonts.css";
import "../styles/global.css";
import sansRegular from "../assets/fonts/TimelessSans-SansRegular-core.woff2?url";
import sansSemibold from "../assets/fonts/TimelessSans-SansSemibold-core.woff2?url";
import groteskMedium from "../assets/fonts/TimelessSans-GroteskMedium-core.woff2?url";
import groteskSemibold from "../assets/fonts/TimelessSans-GroteskSemibold-core.woff2?url";
import monoRegular from "../assets/fonts/GeistMono-Regular-core.woff2?url";
import { REPO } from "../lib/site";
import FloatingDownload from "../components/FloatingDownload.astro";

interface Props {
  title: string;
  description: string;
  /** The header link for the current page. */
  current?: "docs" | "changelog";
  /** URLs of core font files this page sets text in, beyond the ones every page uses. */
  fonts?: string[];
}

const { title, description, current, fonts = [] } = Astro.props;

// The header, footer, docs and changelog titles, and the floating download button use
// these on every page. Only the core files are preloaded. See scripts/subset-fonts.py.
const EVERY_PAGE_FONTS = [sansRegular, sansSemibold, groteskMedium, groteskSemibold, monoRegular];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/icon.png", Astro.site)} />
    <link rel="icon" href="/favicon.png" />
    {[...EVERY_PAGE_FONTS, ...fonts].map(url => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <header class="wrap site-header">
      <a class="home" href="/" aria-label="Rune home">
        <img src="/icon.png" alt="" width="28" height="28" />
        <span>Rune</span>
      </a>
      <nav aria-label="Site">
        <a href="/docs" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
        <a href="/changelog" aria-current={current === "changelog" ? "page" : undefined}>Changelog</a>
        <a href={REPO}>GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="wrap site-footer">
      <span>Rune is open source and made by <a href="https://shivam.dev">Shivam Mishra</a>.</span>
      <nav aria-label="Footer">
        <a href="/docs">Docs</a>
        <a href="/changelog">Changelog</a>
        <a href={REPO}>Source</a>
      </nav>
    </footer>
    <FloatingDownload />
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.25rem;
  }

  .home img {
    display: block;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 6rem;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .site-footer a {
    color: var(--muted);
  }

  .site-footer a:hover {
    color: var(--ink);
  }
</style>
